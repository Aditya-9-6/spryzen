# Spryzen+ Public Environment Configuration Example
# Copy this to .env.local for local development

# Razorpay Payment Gateway (Public Key for Client-Side Checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Resend Email Service (For OTP Login & Invoices)
RESEND_API_KEY=re_your_api_key_here

# Telemetry / Proxy Backend (Optional)
NEXT_PUBLIC_SPRYZEN_GATEWAY_URL=https://api.spryzen.com
